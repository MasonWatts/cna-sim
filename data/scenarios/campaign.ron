// data/scenarios/campaign.ron
//
// The full Campaign Game (rules §64). Per §64.3 the campaign uses the §60.0 "Italian Offensive"
// initial deployment (3rd week of September 1940, 1st OpStage of Game-Turn 1) and then runs — it
// does NOT stop at Scenario 1's length — through the 3rd OpStage of Game-Turn 111 (§64.2), with
// the full reinforcement schedule, production, convoys, and the §64.7 campaign victory conditions.
//
// STRUCTURE
//   * `placements` / `units` — the §60.31/§60.41 Sept-1940 start force (identical to
//     `italian-offensive.ron`; that IS the campaign's initial deployment, §64.3).
//   * `rommel` — General Rommel arrives Game-Turn 26 (§64.2 "Desert Fox" date), the on-map Axis
//     fallback hex Benghazi (A4827), since Tripoli is an off-map node.
//   * `reinforcements` — every formation whose OB units all carry explicit `Turn` arrivals
//     (the Deutsches Afrika Korps and the later Italian / Commonwealth formations). Each enters at
//     its nationality debarkation point (§20.14 CW Cairo / §20.15 Axis Tripoli) on its OB schedule.
//
// OB-ARRIVAL FIXES: the German Ramcke brigade and the Non-Divisional Artillery pool each had one
// stray `Deployed` unit (Ramcke's I Bn (Kroh); the II/155 reassignment counter) that wrongly put a
// German unit on-map in Sept 1940. Those are now dated from the §4.44c OA sheet (I Bn 1/91; II/155
// to the Nov-1941 2/58 reassignment), so both formations are all-`Turn` and enter here on schedule.
// The **Kampfgruppen HQ's** are intentionally omitted: they are a dynamic pool the Axis forms and
// disbands at will (§4.44c prose), not a scheduled arrival.
//
// D14 VERIFICATION (2026-09-08, closed): every `Deployed`-default unit in the CW/Italian OB was
// cross-checked (formation-scoped) against the §4.44a/§4.44b OA-sheet "Arrives" columns and found
// faithful — the Italian 10th Army was entirely in Libya Sept 1940, and 6th Australian/2nd NZ carry
// "D" HQs on their own sheets, 70th Infantry matches exactly (HQ 2/21, 16th Bde on loan to 4th
// Indian). No OB corrections were needed. 70th Inf / 6th Australian / 2nd NZ are intentionally NOT
// listed here: the on-map start force is the §60.41 chart (7th Armoured + 4th Indian + border
// battalions); §4.44 "D" is a master-OB availability marker gated by each scenario's deployment
// chart, and the loader only schedules `Arrival::Turn` units for reinforcement-only formations.
//
// FORTIFICATIONS VERIFICATION (2026-09-10, closed): the full §60.31–60.44 deployment charts (text
// rules) place NO field-fortification counters, minefields, or explicit Fortification Levels — the
// only start-of-game forts are the §25.12 inherent Major-City levels (Level 2 each city; Level 3
// Cairo E1430 / Alexandria E3613), which the engine supplies automatically via
// `city_static_fort_base`. Hence there is deliberately no `fortifications:` field here; field forts
// are built in-play with `BuildFortification` (§24.4). Adding any at start would be fabrication.
(
    name: "Campaign Game",
    game_turn: 1,
    first_turn_initiative: Some(Axis),
    // §31 / §64.2: Rommel and the DAK arrive at Game-Turn 26. On-map fallback hex (Benghazi),
    // since his historical Tripoli debarkation is an off-map node.
    rommel: Some((hex: "A4827", arrival_game_turn: 26)),

    // ---- §60.0 initial deployment (Sept 1940) — the campaign start (§64.3) ----
    placements: [
        (nationality: Italian, formation: "64 Catanzaro Division", hex: "C4707"),
        (nationality: Italian, formation: "62 Marmarica Division",  hex: "C3918"),
        (nationality: Italian, formation: "63 Cirene Division",     hex: "C4120"),
        (nationality: Commonwealth, formation: "7th Armored Division", hex: "D3612", unit_hexes: [
            ("1st KRRC",           "C3922"),
            ("4th Ryl Horse Arty", "C3922"),
            ("3rd Ryl Horse Arty", "C3721"),
            ("1st Royal Tank Regt", "C3520"),
            ("2nd Rifle Brigade",  "C3320"),
            ("11th Hussars",       "C3020"),
        ]),
        (nationality: Commonwealth, formation: "4th Indian Division", hex: "D3615", unit_hexes: [
            ("31st Field Artillery Regt", "C4131"),
        ]),
    ],
    units: [
        // ---- Italian border force (§60.31) ----
        (nationality: Italian, id_code: "p", name: "1 CCNN Division",   org_size: Division, hex: "C4218", composition: Organic(current_toe: 12), trucks: (light: 10, medium: 25, heavy: 10)),
        (nationality: Italian, id_code: "p", name: "1 Libyan Division",  org_size: Division, hex: "C4020", composition: Organic(current_toe: 12), trucks: (light: 10, medium: 15)),
        (nationality: Italian, id_code: "p", name: "2 Libyan Division",  org_size: Division, hex: "C3920", composition: Organic(current_toe: 12), trucks: (light: 15, medium: 15)),
        (nationality: Italian, id_code: "k", name: "Aresca Tank Regiment", org_size: StandardBrigade, hex: "C3919", composition: Weapons(groups: [(system: "M 11/39", count: 6)]), trucks: (medium: 5, heavy: 5)),
        (nationality: Italian, id_code: "p", name: "Maletti Group", org_size: StandardBrigade, is_hq: true, hex: "C3617", composition: Organic(current_toe: 1), trucks: (light: 5, medium: 30, heavy: 5)),
        (nationality: Italian, id_code: "k", name: "Maletti Tank Bn",     org_size: Battalion, composition: Weapons(groups: [(system: "M 11/39", count: 6)]), attached_to: "Maletti Group"),
        (nationality: Italian, id_code: "p", name: "1st Libyan Battalion", org_size: Battalion, composition: Organic(current_toe: 5), attached_to: "Maletti Group"),
        (nationality: Italian, id_code: "p", name: "2nd Libyan Battalion", org_size: Battalion, composition: Organic(current_toe: 5), attached_to: "Maletti Group"),
        (nationality: Italian, id_code: "p", name: "4 CCNN Division", org_size: Division, hex: "C4507", composition: Organic(current_toe: 12), trucks: (light: 10, medium: 25, heavy: 10)),
        (nationality: Italian, id_code: "p", name: "Bardia Garrison", org_size: StandardBrigade, hex: "C4321", composition: Organic(current_toe: 6), trucks: (medium: 20)),
        (nationality: Italian, id_code: "p", name: "Tobruk Garrison", org_size: StandardBrigade, hex: "C4807", composition: Organic(current_toe: 4), trucks: (medium: 5)),
        // ---- Commonwealth border force (§60.41) not part of 7th Armoured ----
        (nationality: Commonwealth, id_code: "h", name: "2nd Scots Guards", org_size: Battalion, hex: "C4131", composition: Organic(current_toe: 4), basic_morale: 1, trucks: (medium: 10)),
        (nationality: Commonwealth, id_code: "h", name: "1st French Motor Marines", org_size: Battalion, hex: "C3926", composition: Organic(current_toe: 2), trucks: (medium: 2)),
        (nationality: Commonwealth, id_code: "h", name: "3rd Coldstream Guards", org_size: Battalion, hex: "C3922", composition: Organic(current_toe: 4), basic_morale: 1, trucks: (medium: 15, heavy: 5)),
        (nationality: Commonwealth, id_code: "x", name: "7th Medium Artillery Regt", org_size: Battalion, hex: "C3922", composition: Weapons(groups: [(system: "4.5\" Gun", count: 3)])),
        (nationality: Commonwealth, id_code: "h", name: "1st Royal Northumberland Fusiliers", org_size: Battalion, hex: "C3721", composition: Organic(current_toe: 4), basic_morale: 1, trucks: (light: 5, medium: 5)),
    ],

    // ---- §64 reinforcement schedule: formations that arrive after Game-Turn 1 (all OB units
    //      carry explicit `Turn` arrivals). They debark at their nationality point (§20.14/§20.15)
    //      and build their hierarchy there on schedule. ----
    reinforcements: [
        // Deutsches Afrika Korps and German follow-on formations (§4.44c).
        (nationality: German, formation: "5 Leichte / 21 Panzer Division"),
        (nationality: German, formation: "15 Panzer Division"),
        (nationality: German, formation: "90 Leichte Afrika Division"),
        (nationality: German, formation: "164 Leichte Afrika Division"),
        (nationality: German, formation: "Sonderverband 288"),
        (nationality: German, formation: "300th Oasis Battalion"),
        (nationality: German, formation: "Unassigned Infantry Units"),
        (nationality: German, formation: "Unassigned Anti-Air Units"),
        (nationality: German, formation: "Fallschirmjaeger-Brigade Ramcke"),
        (nationality: German, formation: "Non-Divisional Artillery Units"),
        // Later Italian formations (§4.44b).
        (nationality: Italian, formation: "132 Ariete Armored Division"),
        (nationality: Italian, formation: "133 Littorio Armored Division"),
        (nationality: Italian, formation: "101 Trieste Motorized Division"),
        (nationality: Italian, formation: "102 Trento Motorized Division"),
        (nationality: Italian, formation: "185 Folgore Airborne Division"),
        (nationality: Italian, formation: "16 Pistoia Division"),
        (nationality: Italian, formation: "60 Sabratha Division"),
        (nationality: Italian, formation: "17 Pavia Division"),
        (nationality: Italian, formation: "25 Bologna Division"),
        (nationality: Italian, formation: "55 Savona Division"),
        (nationality: Italian, formation: "27 Brescia Division"),
        (nationality: Italian, formation: "136 Giovani Fascisti Division"),
        (nationality: Italian, formation: "RECAM"),
        (nationality: Italian, formation: "Unassigned Armored Units"),
        (nationality: Italian, formation: "Unassigned Blackshirt Units"),
        // Later Commonwealth formations (§4.44a).
        (nationality: Commonwealth, formation: "8th Armored Division"),
        (nationality: Commonwealth, formation: "10th Armored Division"),
        (nationality: Commonwealth, formation: "44th Infantry Division"),
        (nationality: Commonwealth, formation: "50th Infantry Division"),
        (nationality: Commonwealth, formation: "51st Infantry Division"),
        (nationality: Commonwealth, formation: "1st Army Tank Brigade"),
        (nationality: Commonwealth, formation: "22nd Armored Brigade"),
        (nationality: Commonwealth, formation: "22nd Guards Brigade"),
        (nationality: Commonwealth, formation: "Unassigned Armor-Class Units"),
        (nationality: Commonwealth, formation: "9th Australian Division"),
        (nationality: Commonwealth, formation: "18th Australian Brigade"),
        (nationality: Commonwealth, formation: "3rd Indian Motorized Brigade Group"),
        (nationality: Commonwealth, formation: "5th Indian Division"),
        (nationality: Commonwealth, formation: "10th Indian Division"),
        (nationality: Commonwealth, formation: "18th Indian Brigade"),
        (nationality: Commonwealth, formation: "161st Indian Motor Brigade"),
        (nationality: Commonwealth, formation: "1st South African Infantry Division"),
        (nationality: Commonwealth, formation: "2nd South African Infantry Division"),
        (nationality: Commonwealth, formation: "Unassigned South Africa Units"),
        (nationality: Commonwealth, formation: "Unassigned New Zealand Units"),
        (nationality: Commonwealth, formation: "1st Free French Brigade"),
        (nationality: Commonwealth, formation: "2nd Free French Brigade"),
        (nationality: Commonwealth, formation: "1st Greek Infantry Brigade Group"),
        (nationality: Commonwealth, formation: "The Polish (Carpathian) Brigade"),
        (nationality: Commonwealth, formation: "Unassigned Allied Units"),
    ],

    // ---- §20.8/§20.81 by-type Mandatory Withdrawal choices ([4.43a]) — units named by type, not
    //      by a specific OB counter, so the Commonwealth Player chooses which units satisfy them. ----
    withdrawal_choices: [
        (game_turn: 23, ops_stage: 3, kind: ArmorBrigade, count: 1),      // "1st Armored Bde [2]" — the 2nd Armored Division is not in the OB
        (game_turn: 97, ops_stage: 2, kind: InfantryBattalion, count: 3), // "22nd/200th Guards Bde [HQ] and any three infantry battalions"
    ],

    // ---- Initial supply, dumps, and facilities (§60.34 Axis / §60.44 Commonwealth) ----
    supply_dumps: [
        (side: Axis, at: "C4807", ammo: 200, fuel: 2000, stores: 500),   // Tobruk
        (side: Axis, at: "C4321", ammo: 100, fuel: 1000, stores: 200),   // Bardia
        (side: Axis, at: "A4827", ammo: 100, fuel: 250,  stores: 100),   // Benghazi
        (side: Axis, at: "B5925", ammo: 0,   fuel: 250,  stores: 50),    // Derna
        (side: Axis, at: "Tripoli", ammo: 250, fuel: 5000, stores: 250), // Tripoli box (off-map)
        (side: Axis, at: "C0716", ammo: 100, fuel: 50, stores: 50),
        (side: Commonwealth, at: "D3714", ammo: 1000, fuel: 3000, stores: 4000), // Mersa Matruh
        (side: Commonwealth, at: "C4131", ammo: 250,  fuel: 500,  stores: 100),  // Sidi Barrani
        (side: Commonwealth, at: "E1430", ammo: 999999, fuel: 999999, stores: 999999, water: 999999), // Cairo
        (side: Commonwealth, at: "E3613", ammo: 999999, fuel: 999999, stores: 999999, water: 999999), // Alexandria
    ],
    supply_dump_choices: [
        (side: Axis, label: "Dump 1", count: 1, ammo: 1000, fuel: 1500, stores: 1500, water: 200,
            constraint: (section: Some('C'), not_within_of_enemy: Some(4))),
        (side: Axis, label: "Dump 2", count: 1, ammo: 1000, fuel: 1500, stores: 1000, water: 200,
            constraint: (section: Some('C'), not_within_of_enemy: Some(4))),
        (side: Axis, label: "Axis dummies", count: 2, dummy: true,
            constraint: (section: Some('C'), not_within_of_enemy: Some(4))),
        (side: Commonwealth, label: "Dump I", count: 1, ammo: 500, fuel: 750, stores: 500,
            constraint: (east_of: Some("C4021"), west_of: Some("E0100"))),
        (side: Commonwealth, label: "Dump I dummy", count: 1, dummy: true,
            constraint: (east_of: Some("C4021"), west_of: Some("E0100"))),
    ],
    repair_facilities: [
        (at: "C4807", kind: Temporary), // Tobruk (Axis)
        (at: "A4827", kind: Temporary), // Benghazi (Axis)
        (at: "E3613", kind: Major),     // Alexandria (Commonwealth)
        (at: "D3714", kind: Temporary), // Mersa Matruh (Commonwealth)
    ],

    // ---- Starting on-map air facilities (§36.1). INFERRED placement (2026-09-10): airfields sit at
    //      the scenario's own designated base hubs (the repair-facility / major-supply hexes), pending
    //      a verbatim §60 starting-airfield chart. Commonwealth off-map basing uses the §36.53 chart
    //      via BaseSquadronOffMap, so those boxes are NOT listed here. ----
    air_facilities: [
        (at: "C4807", kind: Airfield), // Tobruk (Axis)
        (at: "A4827", kind: Airfield), // Benghazi (Axis)
        (at: "E3613", kind: Airfield), // Alexandria (Commonwealth)
        (at: "D3714", kind: Airfield), // Mersa Matruh (Commonwealth)
        (at: "E1430", kind: Airfield), // Cairo (Commonwealth)
    ],

    // ---- Initial air: starting plane pools (§60.32 Italian / §60.42 Commonwealth). No German air
    //      at start (the Luftwaffe arrives with the DAK, GT26+). Planes are assigned to the side's
    //      SGSU counters and based at airfields by the player/AI (§35.2) within capacity. The
    //      per-type "refitted" subsets and the SGSU-counter class splits (39 Italian / 14 CW) are
    //      recorded in the source transcription; deploying squadrons awaits the SGSU roster.
    //      (§60.32's 9× unidentified type — OCR'd "2801" in the text rules — is omitted pending
    //      verification.) ----
    initial_planes: [
        (nationality: Italian, planes: [
            ("C.R.42 Falco", 65), ("C.R.32", 70), ("Ba 65", 10), ("Ba 88 Lince", 24),
            ("S.M.79 Sparviero", 133), ("S.M.81 Pipistrello", 17), ("Ca 309 Ghibli", 56),
            ("Ro 37bis", 10),
        ]),
        (nationality: Commonwealth, planes: [
            ("Lysander Mk.I", 12), ("Bombay Mk.I", 15), ("Sunderland", 18), ("Blenheim Mk.I", 26),
            ("Blenheim Mk.IV", 12), ("Blenheim Mk.IVF", 9), ("Gladiator Mk.II", 36),
            ("Hurricane Mk.I", 6), ("MS406", 4), ("63.11", 2), ("Valentia", 3),
        ]),
    ],
    // §60.32 Italian pilots (Three's: 3, Two's: 10, One's: 15) and §60.42 Commonwealth pilots
    // (1 Three, 5 Two's, 8 One's). Rated pilots are a finite pool the player assigns to squadrons
    // (§40.12); rating-0 pilots are an unlimited supply (§40.16). No German pilots at start (the
    // Luftwaffe arrives with the DAK, GT26+).
    initial_pilots: [
        (nationality: Italian,      pilots: [(3, 3), (2, 10), (1, 15)]),
        (nationality: Commonwealth, pilots: [(3, 1), (2, 5),  (1, 8)]),
    ],
    // §60.32 Italian SGSU Available: 39; §60.42 Commonwealth SGSU Available: 14. The player deploys
    // these counters to air facilities (§34.82) with DeploySgsu, then assigns pooled planes/pilots.
    // German SGSUs arrive with the DAK (GT26+) and are governed by the §34.82 dynamic cap.
    available_sgsu: [
        (nationality: Italian,      count: 39),
        (nationality: Commonwealth, count: 14),
    ],
)

            name: "Unassigned Infantry Units",
            org_size: StandardBrigade,
            basic_morale: 1,
            units: [
                (name: "Deutsches Afrika Korps HQ", abbr: "Rommel",  id: "a",  comp: Organic(Normal), org_size: Division, arrival: Turn(game_turn: 20, stage: 2), parent: ""),

                (name: "33rd Panzerjaeger Bn",     abbr: "33 Pz",  id: "x", comp: Weapons([("3.7cm Pak 35/36", 5), ("5cm Pak 38", 3)]), org_size: Battalion, arrival: Turn(game_turn: 24, stage: 3), parent: "15th Panzer Div HQ"),
                (name: "33rd Artillery Regt",      abbr: "33 Ar",  id: "u", comp: Weapons([("15cm (sIG33) Medium Infantry Gun", 2)]), org_size: Battalion, arrival: Turn(game_turn: 33, stage: 1), parent: "15th Panzer Div HQ"),

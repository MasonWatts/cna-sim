// data/ob/german.ron — German (DAK) Order of Battle (§4.44c). Reference data (D12).
//
// CHART-VERIFIED (D14 retired for these formations, 2026-08-30): the six loaded DAK formations were
// checked unit-by-unit against the §4.44c German OA sheets (transcribed from the rulebook PDF to
// docs/source-materials/de-ob-4.44c.transcribed.md, pages 162–166) and the corrected [4.46c] German
// Unit Characteristics chart (PDF p171). This replaced the earlier category-guessed ids with the
// counter id-codes from the OA sheets. Note: the OA sheets render the halftrack-infantry code as
// "j", but the §4.46c chart has no "j" — it is "i" (i/j typeface ambiguity), so Schutzen (halftrack)
// battalions use "i" here. Tank/Panzer battalions use "f" (the Tank Bn-Eq code, per the corrected
// characteristics). Weapon-name strings are mapped to §4.47-49 keys; a few genuinely unkeyed strings
// (7.5cm light infantry guns, Pz I) are Organic/omitted rather than invented.
//
// FULL ROSTER PROMOTED (2026-08-31): the remaining five §4.44c sheets were added from the
// chart-verified transcription — 300th Oasis Battalion, Unassigned Infantry Units, Kampfgruppen
// HQ's (dynamic pool), Non-Divisional Artillery Units, and Unassigned Anti-Air Units — for all
// 11 German OA formations. Ids copied verbatim from the sheets; every weapon name maps to an
// exact §4.49 key in data/reference/weapons/german.ron. Pool sheets (no owning HQ) list their
// units independently (parent ""); only the 155th Artillery Regt keeps its I/II/III battalions.
(
    formations: [
        (
            name: "5 Leichte / 21 Panzer Division",
            org_size: Division,
            basic_morale: 2,
            units: [
                (name: "5th Leichte Panzer Div HQ", abbr: "5 Le",  id: "c", comp: Organic(Normal), org_size: Division, arrival: Turn(game_turn: 21, stage: 3), parent: ""),
                (name: "21st Panzer Div HQ",         abbr: "21",    id: "c", comp: Organic(Normal), org_size: Division, arrival: Turn(game_turn: 58, stage: 2), parent: ""),
                (name: "5th Panzer Regt HQ",         abbr: "5 Pz",  id: "c", comp: Organic(Normal), org_size: StandardBrigade, arrival: Turn(game_turn: 21, stage: 2), parent: "21st Panzer Div HQ"),
                (name: "I/5 Panzer Bn",              abbr: "I/5",   id: "f", comp: Weapons([("Pz II", 4), ("Pz III E", 1), ("Pz III H", 7), ("Pz IV D", 1)]), org_size: Battalion, arrival: Turn(game_turn: 22, stage: 1), parent: "5th Panzer Regt HQ"),
                (name: "II/5 Panzer Bn",             abbr: "II/5",  id: "f", comp: Weapons([("Pz II", 5), ("Pz III H", 6), ("Pz IV D", 2), ("Pz IV E", 1)]), org_size: Battalion, arrival: Turn(game_turn: 22, stage: 2), parent: "5th Panzer Regt HQ"),
                (name: "2nd Machinegewehr Bn",       abbr: "2",     id: "n", comp: Organic(Normal), org_size: Battalion, arrival: Turn(game_turn: 24, stage: 2), parent: "21st Panzer Div HQ"),
                (name: "8th Machinegewehr Bn",       abbr: "8",     id: "n", comp: Organic(Normal), org_size: Battalion, arrival: Turn(game_turn: 26, stage: 1), parent: "21st Panzer Div HQ"),
                (name: "39th Panzerjaeger Bn",       abbr: "39",    id: "x", comp: Weapons([("3.7cm Pak 35/36", 5), ("5cm Pak 38", 3)]), org_size: Battalion, arrival: Turn(game_turn: 21, stage: 1), parent: "21st Panzer Div HQ"),
                (name: "605th SP Panzerjaeger Bn",   abbr: "605",   id: "y", comp: Weapons([("Pzjg 1 (SP)", 3)]), org_size: Battalion, arrival: Turn(game_turn: 22, stage: 3), parent: "21st Panzer Div HQ"),
                (name: "I/75 Artillery Bn",          abbr: "I/75",  id: "v", comp: Weapons([("10.5cm (K18) Medium Gun", 3)]), org_size: Battalion, arrival: Turn(game_turn: 23, stage: 1), parent: "21st Panzer Div HQ"),

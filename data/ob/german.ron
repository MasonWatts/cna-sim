        (
            name: "Kampfgruppen HQ's",
            org_size: StandardBrigade,
            basic_morale: 0,
            dynamic: true,
            units: [
                (name: "Kampfgruppe HQ", abbr: "KG", id: "b", comp: Organic(Normal), org_size: StandardBrigade, arrival: Deployed, parent: ""),

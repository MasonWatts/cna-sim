// Air Reconnaissance of Land Units Table (§42.27). The modified die roll is one d6 plus one for
// every four planes completing the recon mission (fractions ignored). Scanning ascending, the first
// row whose max_die >= the modified roll gives the number of battalion-equivalents revealed;
// reveal: None means "All" (reveal every unit in the hex regardless of size-equivalency).
//   <=2 -> 0, 3-4 -> 1, 5-6 -> 2, 7 -> 3, 8 -> 4, 9 -> 5, 10 -> 6, 11 -> 7, 12 -> 8, 13+ -> All.
(
    rows: [
        (max_die: 2,          reveal: Some(0)),
        (max_die: 4,          reveal: Some(1)),
        (max_die: 6,          reveal: Some(2)),
        (max_die: 7,          reveal: Some(3)),
        (max_die: 8,          reveal: Some(4)),
        (max_die: 9,          reveal: Some(5)),
        (max_die: 10,         reveal: Some(6)),
        (max_die: 11,         reveal: Some(7)),
        (max_die: 12,         reveal: Some(8)),
        (max_die: 2147483647, reveal: None),
    ],
)

    "G.50 Freccia":  ( class: Fighter, loadouts: [ (range: 57, tac_air: 3, maneuver: 25, fuel: 1) ], missions: (cap: Day, scramble: Day), manufacturer: "Fiat" ),
    "Re.2000 Falco I":  ( class: Fighter, loadouts: [ (range: 47, tac_air: 2, maneuver: 34, fuel: 2) ], missions: (cap: Day, scramble: Day), manufacturer: "Reggiane" ),

// data/reference/weapons/german.ron
//
// German Tank & Gun Characteristics Chart (rules §4.49) — DATA.
// Human-readable companion: docs/source-materials/tank-gun-characteristics-german.md
//
// Map keyed by weapon-system name -> WeaponsSystem. Absent rating = "-"/not-applicable.
// `kind` (Tank/Artillery/AntiTank/LightAntiAir/HeavyAntiAir/Reconnaissance) drives
// combined arms (§15.4) and barrage class (§12.6).
// breakdown_adjustment (BAR): German chart uses Right (positive) or none (Some(0)).
// NOTE: all German TANKS have BAR 1R until the 1/31 Game-Turn; the printed BAR here is
// the later value (a time-dependent rule to enforce in code). cpa omitted = "-" (uses
// parent unit CPA).
{
    // --- Tank Weapon Systems ---
    "Pz I":                ( kind: Tank, cpa: Some(24), anti_air: Some((value: 1)), anti_armor: Some((value: 0)), armor_protection: Some((value: 1)), close_assault: Some((off: (value: 2), def: (value: 2))), fuel_rate: Some(2), breakdown_adjustment: Some(0) ),
    "Pz II":               ( kind: Tank, cpa: Some(35), anti_air: Some((value: 0)), anti_armor: Some((value: 1)), armor_protection: Some((value: 2)), close_assault: Some((off: (value: 2), def: (value: 3))), fuel_rate: Some(2), breakdown_adjustment: Some(0) ),
    // Pz III E resolved from CNA Addenda (Sep 1979) §4.49: "25 1 - 4 - 3 4/4 3 0" (reading across the
    // CPA·AA·Barr·A-Arm·Vul·Armor·CA·Fuel·BAR columns) → armor 3, close-assault 4/4, fuel 3, BAR 0.
    "Pz III E":            ( kind: Tank, cpa: Some(25), anti_air: Some((value: 1)), anti_armor: Some((value: 4)), armor_protection: Some((value: 3)), close_assault: Some((off: (value: 4), def: (value: 4))), fuel_rate: Some(3), breakdown_adjustment: Some(0) ),
    "Pz III H":            ( kind: Tank, cpa: Some(25), anti_air: Some((value: 1)), anti_armor: Some((value: 4)), armor_protection: Some((value: 4)), close_assault: Some((off: (value: 4), def: (value: 4))), fuel_rate: Some(4), breakdown_adjustment: Some(0) ),
    "Pz III J (Special)":  ( kind: Tank, cpa: Some(26), anti_air: Some((value: 1)), anti_armor: Some((value: 6)), armor_protection: Some((value: 4)), close_assault: Some((off: (value: 7), def: (value: 5))), fuel_rate: Some(3), breakdown_adjustment: Some(0) ),
    "Pz IV D":             ( kind: Tank, cpa: Some(25), anti_air: Some((value: 1)), anti_armor: Some((value: 6)), armor_protection: Some((value: 3)), close_assault: Some((off: (value: 5), def: (value: 4))), fuel_rate: Some(4), breakdown_adjustment: Some(0) ),
    "Pz IV E":             ( kind: Tank, cpa: Some(25), anti_air: Some((value: 1)), anti_armor: Some((value: 6)), armor_protection: Some((value: 3)), close_assault: Some((off: (value: 5), def: (value: 5))), fuel_rate: Some(4), breakdown_adjustment: Some(0) ),
    "Pz IV F2 (Special)":  ( kind: Tank, cpa: Some(25), anti_air: Some((value: 1)), anti_armor: Some((value: 8)), armor_protection: Some((value: 4)), close_assault: Some((off: (value: 6), def: (value: 5))), fuel_rate: Some(4), breakdown_adjustment: Some(0) ),


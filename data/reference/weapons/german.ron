    "2.8cm s.Pz.B.41 (28/20 Pak)": ( kind: AntiTank, cpa: Some(15), anti_armor: Some((value: 4)), vulnerability: Some((value: 2)), close_assault: Some((off: (value: 1), def: (value: 1))), fuel_rate: Some(1), notes: ["air-transportable/droppable"] ),

// Breakdown Table (§21.38). Columns = Accumulated Breakdown Points ranges; each band gives the
// highest sequential-read roll (§12.42, larger×10+smaller, 11–66) yielding that % breakdown.
// BAR (negative = column shift Left) and Hot weather / Sandstorm (+1 Right each, cumulative)
// shift the column before rolling. Transcription in docs/source-materials/breakdown.md.
(
    columns: [
        (bp_max: 3,      bands: [(max_roll: 66, percent: 0)]),
        (bp_max: 10,     bands: [(max_roll: 42, percent: 0), (max_roll: 64, percent: 10), (max_roll: 65, percent: 25), (max_roll: 66, percent: 33)]),
        (bp_max: 20,     bands: [(max_roll: 32, percent: 0), (max_roll: 62, percent: 10), (max_roll: 64, percent: 25), (max_roll: 65, percent: 33), (max_roll: 66, percent: 50)]),
        (bp_max: 30,     bands: [(max_roll: 26, percent: 0), (max_roll: 55, percent: 10), (max_roll: 62, percent: 25), (max_roll: 65, percent: 33), (max_roll: 66, percent: 50)]),
        (bp_max: 40,     bands: [(max_roll: 23, percent: 0), (max_roll: 53, percent: 10), (max_roll: 61, percent: 25), (max_roll: 64, percent: 33), (max_roll: 66, percent: 50)]),
        (bp_max: 50,     bands: [(max_roll: 16, percent: 0), (max_roll: 46, percent: 10), (max_roll: 56, percent: 25), (max_roll: 63, percent: 33), (max_roll: 65, percent: 50), (max_roll: 66, percent: 75)]),
        (bp_max: 60,     bands: [(max_roll: 14, percent: 0), (max_roll: 42, percent: 10), (max_roll: 54, percent: 25), (max_roll: 63, percent: 33), (max_roll: 65, percent: 50), (max_roll: 66, percent: 75)]),
        (bp_max: 70,     bands: [(max_roll: 33, percent: 10), (max_roll: 52, percent: 25), (max_roll: 62, percent: 33), (max_roll: 64, percent: 50), (max_roll: 66, percent: 75)]),
        (bp_max: 999999, bands: [(max_roll: 25, percent: 10), (max_roll: 43, percent: 25), (max_roll: 55, percent: 33), (max_roll: 63, percent: 50), (max_roll: 66, percent: 75)]),
    ],
)

// Axis Truck Production Chart (§20.66a). `total` = lifetime Truck Points that may be brought in;
// `tonnage` = Axis Naval Convoy tons to ship one point; `schedule` = phased per-Game-Turn maxima
// (from Game-Turn `from_gt`). Planned points arrive two weeks (Game-Turns) later.
// Transcription in docs/source-materials/replacements.md.
(
    light:  (total: 835,  tonnage: 45,  schedule: [(from_gt: 4, max_per_turn: 4),  (from_gt: 13, max_per_turn: 15)]),
    medium: (total: 2890, tonnage: 80,  schedule: [(from_gt: 6, max_per_turn: 20), (from_gt: 13, max_per_turn: 50)]),
    heavy:  (total: 525,  tonnage: 150, schedule: [(from_gt: 5, max_per_turn: 3),  (from_gt: 13, max_per_turn: 8)]),
)

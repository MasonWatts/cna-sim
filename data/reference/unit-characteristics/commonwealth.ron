// data/reference/unit-characteristics/commonwealth.ron
//
// Commonwealth Unit Characteristics Chart (rules §4.46a) — DATA.
// Human-readable companion: docs/source-materials/unit-characteristics-commonwealth.md
//
// Map keyed by ID code -> UnitCharacteristics. Absent rating = "-"/not-applicable, or
// (for HQ/tank/artillery/AT/AA codes) derived from the weapons systems the unit holds.
// cpa: retains_regardless = chart '*'; motorized_capable = chart '+'.
// max_toe: parenthesized = chart '( )'; us_tank_special = chart '**' (all-US-tank => 9).
{
    // --- Headquarters ---
    "a": ( unit_type: "Headquarters", cpa: (value: 30) ),
    "b": ( unit_type: "Headquarters", cpa: (value: 30, retains_regardless: true), max_toe: Some((value: 1, parenthesized: true)), assignments: [(weapon_kind: Tank, max_count: 1)] ),
    "c": ( unit_type: "Headquarters", cpa: (value: 30), max_toe: Some((value: 3)), assignments: [(weapon_kind: Artillery, max_count: 3)] ),
    "d": ( unit_type: "Headquarters", cpa: (value: 20, retains_regardless: true), max_toe: Some((value: 1, parenthesized: true)), assignments: [(weapon_kind: Tank, max_count: 1)] ),
    "e": ( unit_type: "Headquarters", cpa: (value: 20), close_assault: Some((off: (value: 0), def: (value: 1))) ),
    "f": ( unit_type: "Headquarters", cpa: (value: 20), close_assault: Some((off: (value: 0), def: (value: 1))) ),

    // --- Tank Bn-Equivalent ---

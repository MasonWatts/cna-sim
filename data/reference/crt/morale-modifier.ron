        [(11, 46, Delta(0)), (51, 56, Delta(-1)), (61, 66, Delta(-2))],                                       // -2
        [(11, 42, Delta(0)), (43, 46, Delta(-1)), (51, 66, Delta(-2))],                                       // -3
        [(11, 33, Delta(0)), (34, 41, Delta(-1)), (42, 55, Delta(-2)), (61, 66, Delta(-3))],                  // -4
        [(11, 23, Delta(0)), (24, 32, Delta(-1)), (33, 46, Delta(-2)), (51, 66, Delta(-3))],                  // -5
        [(11, 12, Delta(0)), (13, 25, Delta(-1)), (26, 36, Delta(-2)), (41, 63, Delta(-3)), (64, 66, Delta(-4))], // -6
        [(11, 11, Delta(0)), (12, 16, Delta(-1)), (21, 33, Delta(-2)), (34, 51, Delta(-3)), (52, 63, Delta(-4)), (64, 66, Surrender)], // -7
        [(11, 13, Delta(-1)), (14, 31, Delta(-2)), (32, 44, Delta(-3)), (45, 61, Delta(-4)), (62, 66, Surrender)], // -8
